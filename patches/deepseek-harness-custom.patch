+/**
+ * Treat an incomplete route emitted as empty optional fields as omission.
+ * Omission inherits the configured or parent route; an empty id cannot select
+ * a model and should not fail an otherwise valid delegation.
+ */
+export function normalizeDelegationModelRequest(request: DelegationModelRequest): DelegationModelRequest {
+  if (request.provider !== '' && request.model !== '') return request
+  const { provider: _provider, model: _model, ...rest } = request
+  return rest
+}
